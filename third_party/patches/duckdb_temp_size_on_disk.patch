 void TemporaryFileManager::DecreaseSizeOnDisk(idx_t bytes) {
-	size_on_disk -= bytes;
+	// Saturating subtraction: if the accounting ever drifts (more bytes released than were reserved), clamp at 0
+	// instead of wrapping the unsigned counter to ~2^64, which would make every later spill fail with
+	// "failed to offload data block ... (16383.9 PiB/... used)" until the process restarts.
+	auto current = size_on_disk.load(std::memory_order_relaxed);
+	idx_t desired;
+	do {
+		desired = current > bytes ? current - bytes : 0;
+	} while (!size_on_disk.compare_exchange_weak(current, desired, std::memory_order_relaxed));
 }
 
