cmake_minimum_required(VERSION 3.25)
project(opentelemetry)

set(CMAKE_CXX_STANDARD 17)

include(ExternalProject)

# Parent build directory (set by parent CMake via configure_file @ONLY)
set(PARENT_BINARY_DIR "@CMAKE_BINARY_DIR@")

# Arrow 23 builds protobuf via FetchContent — headers and libs live in the
# Arrow *build* tree, NOT the install prefix.  Paths are fully resolved by the
# parent CMakeLists.txt and substituted here via configure_file @ONLY.
set(PROTOBUF_INCLUDE_DIR "@ARROW_PROTOBUF_INCLUDE_DIR@")
set(PROTOBUF_LIB "@ARROW_PROTOBUF_LIB@")
set(PROTOBUF_LITE_LIB "@ARROW_PROTOBUF_LITE_LIB@")
set(PROTOBUF_PROTOC "@ARROW_PROTOC_EXECUTABLE@")
set(ABSL_INCLUDE_DIR "@ARROW_ABSL_INCLUDE_DIR@")
set(UTF8_RANGE_INCLUDE_DIR "@ARROW_UTF8_RANGE_INCLUDE_DIR@")

# The ETW exporter only exists on Windows, where it defaults to ON. Since
# v1.29.0 opentelemetry-cpp fails configuration if OTELCPP_WITH_ETW is set at
# all on other platforms, so only pass it on Windows.
set(OTEL_ETW_ARGS "")
if(WIN32)
  set(OTEL_ETW_ARGS -DOTELCPP_WITH_ETW=OFF)
endif()

# Build OpenTelemetry with HTTP exporter only (no gRPC dependency)
ExternalProject_Add(
    opentelemetry_project
    PREFIX ${CMAKE_BINARY_DIR}/third_party
    GIT_REPOSITORY https://github.com/open-telemetry/opentelemetry-cpp.git
    GIT_TAG v1.29.0
    UPDATE_DISCONNECTED TRUE
    CMAKE_ARGS
      -DCMAKE_INSTALL_PREFIX=${PARENT_BINARY_DIR}/third_party/opentelemetry
      -DCMAKE_INSTALL_LIBDIR=lib
      -DCMAKE_CXX_STANDARD=17
      -DCMAKE_BUILD_TYPE=${CMAKE_BUILD_TYPE}
      -DOTELCPP_BUILD_TESTING=OFF
      -DOTELCPP_WITH_EXAMPLES=OFF
      -DOTELCPP_WITH_BENCHMARK=OFF
      -DOTELCPP_WITH_FUNC_TESTS=OFF
      # Disable gRPC exporter entirely
      -DOTELCPP_WITH_OTLP_GRPC=OFF
      # Enable HTTP exporter with curl
      -DOTELCPP_WITH_OTLP_HTTP=ON
      # Use Arrow's bundled protobuf (via FetchContent).
      # Block any system protobuf (e.g. Homebrew) so that the cache variables
      # below are authoritative.  CMAKE_IGNORE_PREFIX_PATH prevents config-mode
      # find_package from discovering system packages.
      -DCMAKE_IGNORE_PREFIX_PATH=/opt/homebrew$<SEMICOLON>/usr/local
      # Arrow 25's protobuf headers include absl (and reference utf8_range)
      # headers, which live in Arrow's FetchContent source trees
      "-DCMAKE_CXX_FLAGS=-I${ABSL_INCLUDE_DIR} -I${UTF8_RANGE_INCLUDE_DIR} @GIZMOSQL_SANITIZER_FLAGS@"
      "-DCMAKE_C_FLAGS=@GIZMOSQL_SANITIZER_FLAGS@"
      "-DCMAKE_EXE_LINKER_FLAGS=@GIZMOSQL_SANITIZER_LINK_FLAGS@"
      "-DCMAKE_SHARED_LINKER_FLAGS=@GIZMOSQL_SANITIZER_LINK_FLAGS@"
      -DProtobuf_INCLUDE_DIR=${PROTOBUF_INCLUDE_DIR}
      -DProtobuf_LIBRARY=${PROTOBUF_LIB}
      -DProtobuf_LITE_LIBRARY=${PROTOBUF_LITE_LIB}
      -DProtobuf_PROTOC_EXECUTABLE=${PROTOBUF_PROTOC}
      -Dprotobuf_MODULE_COMPATIBLE=ON
      # Build static libraries
      -DBUILD_SHARED_LIBS=OFF
      # Disable unnecessary components
      -DOTELCPP_WITH_PROMETHEUS=OFF
      -DOTELCPP_WITH_ZIPKIN=OFF
      -DOTELCPP_WITH_ELASTICSEARCH=OFF
      ${OTEL_ETW_ARGS}
      -DOTELCPP_WITH_API_ONLY=OFF
)
