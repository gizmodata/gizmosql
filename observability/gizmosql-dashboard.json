{
  "uid": "gizmosql-runtime",
  "title": "GizmoSQL Runtime Metrics",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "tags": [
    "gizmosql"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(gizmosql_build_info, namespace)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "sort": 1
      },
      {
        "name": "pod",
        "label": "Pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(gizmosql_build_info{namespace=~\"$namespace\"}, pod)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "sort": 1
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(gizmosql_build_info, instance)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "DuckDB memory",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gizmosql_duckdb_memory_used_bytes{namespace=~\"$namespace\",pod=~\"$pod\",instance=~\"$instance\"}",
          "legendFormat": "{{pod}} Used"
        },
        {
          "refId": "B",
          "expr": "gizmosql_duckdb_memory_limit_bytes{namespace=~\"$namespace\",pod=~\"$pod\",instance=~\"$instance\"}",
          "legendFormat": "{{pod}} DuckDB limit"
        },
        {
          "refId": "C",
          "expr": "gizmosql_cgroup_memory_limit_bytes{namespace=~\"$namespace\",pod=~\"$pod\",instance=~\"$instance\"}",
          "legendFormat": "{{pod}} Container limit"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Process resident memory",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{namespace=~\"$namespace\",pod=~\"$pod\",instance=~\"$instance\"}",
          "legendFormat": "{{pod}} RSS"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "Process CPU cores used",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_cpu_seconds_total{namespace=~\"$namespace\",pod=~\"$pod\",instance=~\"$instance\"}[5m])",
          "legendFormat": "{{pod}} CPU cores"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "Sessions",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gizmosql_sessions{namespace=~\"$namespace\",pod=~\"$pod\",instance=~\"$instance\"}",
          "legendFormat": "{{pod}} {{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "Statements per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(gizmosql_statements_total{namespace=~\"$namespace\",pod=~\"$pod\",instance=~\"$instance\"}[5m])",
          "legendFormat": "{{pod}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "Statement duration p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (instance, pod, kind, le) (rate(gizmosql_statement_duration_seconds_bucket{namespace=~\"$namespace\",pod=~\"$pod\",instance=~\"$instance\"}[5m])))",
          "legendFormat": "{{pod}} {{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "Admission queue",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gizmosql_queue_depth{namespace=~\"$namespace\",pod=~\"$pod\",instance=~\"$instance\"}",
          "legendFormat": "{{pod}} Queued"
        },
        {
          "refId": "B",
          "expr": "gizmosql_concurrency_limit{namespace=~\"$namespace\",pod=~\"$pod\",instance=~\"$instance\"}",
          "legendFormat": "{{pod}} Concurrency limit"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "Active statements",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gizmosql_statements_active{namespace=~\"$namespace\",pod=~\"$pod\",instance=~\"$instance\"}",
          "legendFormat": "{{pod}} {{wait}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "title": "Health and collection",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gizmosql_health_check_status{namespace=~\"$namespace\",pod=~\"$pod\",instance=~\"$instance\"}",
          "legendFormat": "{{pod}} Health"
        },
        {
          "refId": "B",
          "expr": "gizmosql_metrics_collection_success{namespace=~\"$namespace\",pod=~\"$pod\",instance=~\"$instance\"}",
          "legendFormat": "{{pod}} Local collector"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "title": "Spill and WAL",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gizmosql_duckdb_spill_bytes{namespace=~\"$namespace\",pod=~\"$pod\",instance=~\"$instance\"}",
          "legendFormat": "{{pod}} Spill"
        },
        {
          "refId": "B",
          "expr": "gizmosql_wal_bytes{namespace=~\"$namespace\",pod=~\"$pod\",instance=~\"$instance\"}",
          "legendFormat": "{{pod}} WAL"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 11,
      "title": "Process resources",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_threads{namespace=~\"$namespace\",pod=~\"$pod\",instance=~\"$instance\"}",
          "legendFormat": "{{pod}} Threads"
        },
        {
          "refId": "B",
          "expr": "process_open_fds{namespace=~\"$namespace\",pod=~\"$pod\",instance=~\"$instance\"}",
          "legendFormat": "{{pod}} File descriptors"
        },
        {
          "refId": "C",
          "expr": "process_open_handles{namespace=~\"$namespace\",pod=~\"$pod\",instance=~\"$instance\"}",
          "legendFormat": "{{pod}} Windows handles"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ],
  "description": "Namespace/Pod variables filter Kubernetes scrapes (PodMonitor labels); they match everything on non-Kubernetes deployments."
}
